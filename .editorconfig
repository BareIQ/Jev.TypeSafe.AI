root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.cs]
# ---- Language style (enforced in build) -------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning
csharp_prefer_braces = when_multiline:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_diagnostic.IDE0005.severity = warning   # remove unnecessary usings
dotnet_diagnostic.IDE0040.severity = warning   # accessibility modifiers required
dotnet_diagnostic.IDE0044.severity = warning   # make field readonly
dotnet_diagnostic.IDE0161.severity = warning   # file-scoped namespaces

# ---- Naming ----------------------------------------------------------------------------
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.private_static_fields_s.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_s.style = s_camel
dotnet_naming_rule.private_static_fields_s.severity = warning
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static
dotnet_naming_style.s_camel.capitalization = camel_case
dotnet_naming_style.s_camel.required_prefix = s_

dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

# ---- Analyzer opt-outs (each justified) ---------------------------------------------------
# CA1303: The SDK is English-only; messages mirror upstream and are not localized resources.
dotnet_diagnostic.CA1303.severity = none
# CA1062: Nullable reference types are enabled; public entry points use Guard for runtime checks.
dotnet_diagnostic.CA1062.severity = none
# CA1710: Domain names (QuestionSet, AnswerSet, ChoiceCriteria) read better than *Collection suffixes.
dotnet_diagnostic.CA1710.severity = none
# CA5399/CA5400: Certificate revocation behavior is left to the platform defaults, as with any HttpClient;
# callers needing CRL checks can supply their own configured HttpClient.
dotnet_diagnostic.CA5399.severity = none
dotnet_diagnostic.CA5400.severity = none
# CA1032: API exceptions are meaningless without response context; they intentionally expose
# domain constructors instead of the parameterless/message-only set.
dotnet_diagnostic.CA1032.severity = none
# CA1716: 'True'/'False' are the wire names of noul criteria and are not virtual/interface members.
dotnet_diagnostic.CA1716.severity = none
# CA2225: Named alternates exist under clearer names (Entry.FromText/FromJson, ScoreCriteria.FromEntries/FromTexts).
dotnet_diagnostic.CA2225.severity = none
# Passing a disposable to a constructor (e.g. HttpClientHandler to HttpClient) transfers ownership.
dotnet_code_quality.CA2000.dispose_ownership_transfer_at_constructor = true
